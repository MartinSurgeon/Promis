APP_NAME="PROMIS - USTED"
APP_ENV="local"
APP_DEBUG=true
APP_URL="http://localhost/promis/public"
APP_TIMEZONE="Africa/Accra"
APP_KEY="base64:cHJvbWlzLXVzdGVkLWxvY2FsLWRldmVsb3BtZW50LWtleQ=="

# Database Connection Settings (XAMPP Default)
DB_ENGINE="mariadb"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="promis"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"
