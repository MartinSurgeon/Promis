# =============================================================================
# PROMIS ENVIRONMENT CONFIGURATION TEMPLATE
# University of Science and Technology, Dedicated (USTED)
# =============================================================================

# Application Settings
APP_NAME="PROMIS - USTED"
APP_ENV="local"              # "local", "development", "staging", "production"
APP_DEBUG=true               # Set false in production
APP_URL="http://localhost/promis/public"
APP_TIMEZONE="Africa/Accra"
APP_KEY="base64:ChangeThisToA32ByteRandomStringForProductionSecurity="

# Database Connection Settings
# DB_ENGINE: "mariadb" for local XAMPP MariaDB 10.4+, "mysql" for MySQL 8.x
DB_ENGINE="mariadb"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="promis"
DB_USERNAME="root"
DB_PASSWORD=""
DB_CHARSET="utf8mb4"
# DB_COLLATION: "utf8mb4_unicode_ci" for MariaDB 10.4, "utf8mb4_0900_ai_ci" for MySQL 8.x
DB_COLLATION="utf8mb4_unicode_ci"

# Session Security Configuration
SESSION_LIFETIME=7200        # Lifetime in seconds (2 hours)
SESSION_SECURE=false         # Set true when running under HTTPS in production
SESSION_HTTPONLY=true        # Prevent JavaScript access to session cookie
SESSION_SAMESITE="Lax"       # "Lax" or "Strict"
SESSION_COOKIE_NAME="promis_session"

# Storage Settings
STORAGE_LOG_PATH="storage/logs/app.log"
STORAGE_UPLOAD_PATH="storage/uploads"
